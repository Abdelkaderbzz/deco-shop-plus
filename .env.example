# Copy to .env and fill in values (local dev uses .env only)
# Database (Neon) — sslmode=require is auto-upgraded to verify-full in code
DATABASE_URL=

# Auth (Better Auth)
BETTER_AUTH_SECRET=

# Public site URL (used for canonical URLs, sitemap, and Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Meta Pixel (browser + Conversions API)
NEXT_PUBLIC_META_PIXEL_ID=1225080913168946
META_CAPI_ACCESS_TOKEN=

# Events Manager → Test events code (temporary — remove after testing)
# Example: TEST74384
META_TEST_EVENT_CODE=
NEXT_PUBLIC_META_TEST_EVENT_CODE=

# Optional: require ?key= on /feeds/meta-catalog.csv (recommended in production)
META_CATALOG_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=water-of-cold/products
