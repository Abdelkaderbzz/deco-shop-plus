# Copy to .env and fill in values (local dev uses .env only)
# Database (Neon) — sslmode=require is auto-upgraded to verify-full in code
DATABASE_URL=

# Auth (Better Auth)
BETTER_AUTH_SECRET=

# Public site URL (used for canonical URLs, sitemap, and Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=water-of-cold/products
